# ==============================================================================
# AuraGuard: Comprehensive Git Exclusion Rules & DevSecOps Baseline
# ==============================================================================

# 1. Secrets, Keys, and Cloud Credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.aws/
credentials
aws_credentials.json
secrets.*
*.tfvars
*.tfstate*
*.tfstate.backup

# 2. Python Virtual Environments, Bytecode, & Package Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
develop-eggs/
eggs/
parts/
dist/
build/

# Lambda Packaging Artifacts
lambda/*.zip
lambda/package/
lambda/build/

# 3. Node, Vite, React & Web Build Artifacts
node_modules/
.vite/
.turbo/
coverage/
*.tsbuildinfo
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 4. OS & IDE System Files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~

# 5. Local Agent & AI Tool Directories
.agents/
.gemini/
*.agent/

# 6. Database, Logs, and Local Run Artifacts
*.log
*.sqlite
*.sqlite3
*.db

# 7. Forensic Data & Manifests
# Only the sanitized sample manifest with masked IDs is committed
evidence/*.json
!evidence/sample_manifest.json
!evidence/.gitkeep
evidence/raw/
