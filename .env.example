# ==============================================================================
# AuraGuard: Zero-Trust Autonomous Cloud Forensic Isolation
# Environment Configuration Template (.env.example)
# NOTE: Copy this file to .env and insert your real values. Never commit .env!
# ==============================================================================

# 1. AWS Credentials & Regional Target (Required for Live AWS Mode)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIAEXAMPLEACCESSKEY
AWS_SECRET_ACCESS_KEY=exampleSecretKeyDoNotCommitToGit12345
# AWS_SESSION_TOKEN=  # Optional: required if using temporary STS/SSO credentials

# 2. Network Infrastructure (Foundational VPC & Target Subnet)
VPC_ID=vpc-0xxxxxxxxxxxxxxxxx
SUBNET_ID=subnet-0xxxxxxxxxxxxxxxxx

# 3. Target Workload Node (EC2 Instance under protection/monitoring)
TARGET_INSTANCE_ID=i-0xxxxxxxxxxxxxxxxx

# 4. Zero-Trust Forensic Quarantine Group
# Leave empty to allow AuraGuard to dynamically discover or auto-provision AuraGuard-Quarantine-SG
QUARANTINE_SG_ID=
QUARANTINE_SG_NAME=AuraGuard-Quarantine-SG

# 5. Cryptographic Evidence Vault (S3 Bucket with SSE-AES256)
EVIDENCE_VAULT_BUCKET=auraguard-evidence-vault-sample

# 6. Optional Notification & Alerting
ALERT_SNS_TOPIC_ARN=

# 7. Local Backend API Service Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# 8. Frontend Vite Environment (Optional - only VITE_* variables are exposed to browser)
# VITE_API_BASE_URL=http://127.0.0.1:8000
