# AWS Authentication & Region (Mumbai / ap-south-1)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Network Infrastructure (Pre-provisioned Foundational VPC & Subnet)
VPC_ID=vpc-xxxxxxxxxxxxxxxxx
SUBNET_ID=subnet-xxxxxxxxxxxxxxxxx

# Target EC2 Instance for Forensic Quarantine Simulation
TARGET_INSTANCE_ID=i-xxxxxxxxxxxxxxxxx

# Optional Evidence Vault & Quarantine Configurations
EVIDENCE_VAULT_BUCKET=auraguard-evidence-vault-ap-south-1
QUARANTINE_SG_ID=
ALERT_SNS_TOPIC_ARN=
